{
  "manifest_version": 2,
  "name": "Mail Route Timeline",
  "description": "Shows how a message travelled: each Received hop with the time it took since the previous one.",
  "version": "1.0.5",
  "author": "Mikko Hänninen",
  "browser_specific_settings": {
    "gecko": {
      "id": "mailroute-timeline@iki.fi",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["messagesRead"],
  "icons": { "32": "icon.svg", "64": "icon.svg" },
  "message_display_action": {
    "default_title": "Route",
    "default_icon": "icon.svg",
    "default_popup": "popup.html"
  }
}
